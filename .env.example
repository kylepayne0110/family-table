# Family Table settings template. Copy to .env, then run: python -m app.setup_login

# Shared family login. Set these with:  python -m app.setup_login
FAMILY_USERNAME=
FAMILY_PASSWORD_HASH=

# Where the database and photos live (relative to the project, or an absolute path).
FAMILY_TABLE_DATA_DIR=data

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Largest photo upload accepted, in megabytes.
MAX_UPLOAD_MB=12

# How long a sign-in lasts: normal (hours) and "Keep me signed in" (days).
SESSION_HOURS=12
REMEMBER_DAYS=30

# The household's time zone. A planned dinner stays on the Meal Planner until midnight here.
HOUSEHOLD_TIMEZONE=America/Chicago

# Cooking Assistant: the local Ollama server and model. Only the server talks to Ollama.
# In Docker, use http://host.docker.internal:11434 to reach Ollama on this computer.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=90
